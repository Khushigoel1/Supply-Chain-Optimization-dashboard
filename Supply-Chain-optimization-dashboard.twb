      <column caption='Forecast vs Actual Gap' datatype='real' name='[Calculation_0942582333022210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[forecast_demand]-[units_demand]' />
      </column>
      <column caption='Forecast Accuracy%' datatype='real' name='[Calculation_0942582333321219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-ABS([Calculation_0942582333022210])/[units_demand]' />
