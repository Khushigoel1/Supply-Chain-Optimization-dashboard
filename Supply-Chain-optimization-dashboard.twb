      <column caption='Future Demand Only' datatype='real' name='[Calculation_0139939224727555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_forecast] = TRUE THEN [forecast_demand] ELSE 0 END' />
