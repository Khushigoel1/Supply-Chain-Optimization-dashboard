      <aliases enabled='yes' />
      <column caption='Late Delivery Rate' datatype='string' name='[Calculation_0139939220189185]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(SUM([Late_delivery_risk])&#13;&#10;   / COUNT([Order Id]) * 100, 1)) + &quot;%&quot;' />
      </column>
      <column caption='Avg Lead Time Label' datatype='string' name='[Calculation_0356543664558081]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([lead_time_days]), 1)) + &quot; days&quot;' />
      </column>
      <column caption='Late Delivery Flag' datatype='string' name='[Calculation_0942582331891712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[Late_delivery_risk]=1 then &quot;Late&quot; ELSE &quot;On Time&quot; END' />
      </column>
      <column caption='Profit Margin%' datatype='real' name='[Calculation_0942582332780545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Order Profit Per Order]/[Sales]' />
      </column>
